{
  "openapi": "3.0.3",
  "info": {
    "title": "SourceProof",
    "version": "0.1.2",
    "description": "Checks how well supplied web pages support a claim, using keyword matching, and returns citation snippets and a machine-readable verdict. The verdict measures how much of the claim's wording appears in the sources. It does not establish that the claim is true. Sources must be http or https URLs on ports 80 or 443, and are fetched in parallel under one 8 second deadline. A failing source is reported in source_errors with a 200, never a 5xx."
  },
  "servers": [
    {
      "url": "https://{host}",
      "variables": {
        "host": {
          "default": "localhost"
        }
      }
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "root",
        "responses": {
          "200": {
            "description": "Service identity"
          }
        }
      },
      "head": {
        "operationId": "rootHead",
        "responses": {
          "200": {
            "description": "Same headers as GET, no body"
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      },
      "head": {
        "operationId": "healthHead",
        "responses": {
          "200": {
            "description": "Same headers as GET, no body"
          }
        }
      }
    },
    "/v1/version": {
      "get": {
        "operationId": "version",
        "responses": {
          "200": {
            "description": "Service identity and version"
          }
        }
      }
    },
    "/v1/verify": {
      "post": {
        "operationId": "verifyOfficialClaim",
        "summary": "Check how well supplied web sources support a claim",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResponse"
                }
              }
            }
          },
          "400": {
            "description": "invalid_json, invalid_request, or private_or_invalid_url",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "408": {
            "description": "request_timeout: the body was not received in time",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "busy: too many verifications in flight; retry after the Retry-After seconds",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "internal_error: unexpected server error (should not occur)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "description": "Keyword-based support check, not fact-checking. Request bodies may use Content-Length or chunked transfer encoding. Source URLs must use ports 80 or 443, including after redirects."
      }
    }
  },
  "components": {
    "schemas": {
      "VerifyRequest": {
        "type": "object",
        "required": [
          "claim",
          "sources"
        ],
        "additionalProperties": false,
        "properties": {
          "claim": {
            "type": "string",
            "maxLength": 1000,
            "description": "The factual claim to check."
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "HTTP(S) pages to inspect."
          }
        }
      },
      "VerifyResponse": {
        "type": "object",
        "required": [
          "claim",
          "verdict",
          "confidence",
          "evidence"
        ],
        "properties": {
          "service": {
            "type": "string",
            "example": "SourceProof"
          },
          "version": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "supported",
              "contradicted",
              "partially_supported",
              "insufficient_evidence"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "source_errors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "url",
                "code",
                "error"
              ],
              "properties": {
                "url": {
                  "type": "string"
                },
                "code": {
                  "type": "string",
                  "description": "unresolvable_host, timeout, connection_failed, blocked_url, unsupported_content_type, fetch_failed, or http_<status>"
                },
                "error": {
                  "type": "string"
                }
              }
            }
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "method": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
